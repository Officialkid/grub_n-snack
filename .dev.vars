# Local Cloudflare environment variables for `wrangler dev` or local testing
# Copy values from your Cloudflare Pages environment or set placeholders for local testing.

# Database
DATABASE_URL=""

# Prisma / Neon
NEON_DATABASE_URL=""

# VAPID keys (if you use web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twilio (if used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER=

# NextAuth secret
NEXTAUTH_SECRET=

# Cloudflare-specific
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PROJECT_NAME="grub-n-snack"
